// Conquer Files (owner, 2026-11-11): the platform's shared file service, the first of the shared
// services. It keeps the index of every document clients and staff upload (POs first, then ticket,
// quotation and deal attachments) and hands out upload permits and short-lived download links.
// The files themselves are in object storage (UploadThing now; Vercel Blob possible later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One uploaded file, attached to one record of one app.
model StoredFile {
  id             String    @id @default(uuid())
  /// The app the record belongs to: CRM or CSP.
  ownerApp       String    @map("owner_app")
  /// PURCHASE_ORDER, CLIENT_REQUEST, TICKET, QUOTATION, OPPORTUNITY.
  ownerType      String    @map("owner_type")
  /// That app's id for the record.
  ownerId        String    @map("owner_id")
  /// How people know the record, for the home page (e.g. "CR-730264 · PO 123").
  ownerLabel     String?   @map("owner_label")
  /// Staff chose to show it to the client (the client's own uploads always are).
  sharedWithClient Boolean @default(false) @map("shared_with_client")
  /// The name the person gave it.
  name           String
  contentType    String    @map("content_type")
  size           Int
  /// UPLOADTHING or VERCEL_BLOB.
  storage        String
  /// The storage's own key for the file.
  storageKey     String    @unique @map("storage_key")
  /// Its address in storage. On UploadThing's free plan files are public at an unguessable
  /// address (no private ACL), so it is only ever handed out after the calling app checked access.
  url            String?
  /// Who uploaded it: STAFF (CRM or CSP user) or CLIENT (Customer Portal).
  uploadedByKind String    @map("uploaded_by_kind")
  uploadedById   String?   @map("uploaded_by_id")
  uploadedByName String?   @map("uploaded_by_name")
  /// Through which app: CRM, PORTAL or CSP.
  uploadedVia    String    @map("uploaded_via")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedByName  String?   @map("deleted_by_name")

  events FileEvent[]

  @@index([ownerApp, ownerType, ownerId])
  @@map("stored_files")
}

/// What happened to a file, for the audit trail: UPLOADED, REJECTED, LINK (a download link
/// handed out), DELETED.
model FileEvent {
  id        Int         @id @default(autoincrement())
  fileId    String?     @map("file_id")
  file      StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  action    String
  /// The calling app (CRM, PORTAL, CSP) and who it said was acting.
  byApp     String      @map("by_app")
  byName    String?     @map("by_name")
  detail    String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([fileId, createdAt])
  @@map("file_events")
}

/// Conquer admins who sign in to the home page (owner, 2026-11-11: admins only).
model Admin {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  /// Set for a password someone else chose (the first admin): changed at the next sign-in.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

/// When each calling app last used its token (the home page shows it).
model CallerUse {
  caller String   @id
  lastAt DateTime @map("last_at")

  @@map("caller_uses")
}
